# Your code here for 3.1
def total_brightness_and_star_brightnesses(magnitudes):
    # 
    star_brightnesses = []
    for i in magnitudes:
        brightness = 10**(-i/2.5)
        star_brightnesses.append(brightness)
    total_brightness = sum(star_brightnesses)
    return total_brightness, star_brightnesses

magnitudes = [12.5, 13.2, 14.8, 19.1, 21.0, 18.5, 15.3, 10.5, 23.0]
